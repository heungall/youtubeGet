# 서버 환경변수입니다. 실제 키를 저장소에 커밋하지 마세요.
SUPABASE_URL=
# Supabase 프로젝트의 publishable key (또는 legacy anon key)
SUPABASE_PUBLISHABLE_KEY=
# 선택: OAuth 완료 후 돌아올 고정 사이트 주소. 예: https://your-app.vercel.app
# 비워 두면 로그인 요청의 주소를 사용합니다. 운영 환경에서 localhost를 넣지 마세요.
APP_URL=
YOUTUBE_API_KEY=
# service-role 키 / AI 키는 현재 사용하지 않습니다.
